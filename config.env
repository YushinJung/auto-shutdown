# auto-shutdown 설정 파일
# 설치 시 /etc/auto-shutdown/config.env 로 복사됩니다.
# 값을 바꾼 뒤에는 재부팅하거나 `systemctl restart auto-shutdown.timer` 할 필요 없이
# 다음 검사(최대 1분)부터 자동 반영됩니다.

# 종료 기능 전체 on/off. false 면 감지/로그만 남기고 절대 종료하지 않음(관찰 모드).
ENABLED=true

# 이 시간(분) 동안 계속 '유휴'면 인스턴스를 종료한다.
IDLE_MINUTES=30

# CPU 사용률(%)이 이 값 이하이면 유휴로 간주.
CPU_THRESHOLD=5

# CPU/디스크/네트워크 순간 사용량을 재기 위한 샘플링 간격(초).
CHECK_INTERVAL=3

# 감시할 포트 목록(공백 구분). 이 포트에 연결(established)이 있으면 사용 중으로 본다.
# 예: Jupyter=8888. 비워두면("") 포트 검사를 하지 않는다.
WATCH_PORTS="8888"

# 감시할 프로세스 패턴 목록(한 줄에 하나). `pgrep -f` 로 명령줄을 검사해 매칭되는
# 프로세스가 하나라도 있으면 CPU/I/O 가 낮아도 사용 중으로 본다.
# 다른 인스턴스의 작업을 기다리는 파이프라인처럼, 오래 돌지만 대기 중엔 자원을 거의
# 안 쓰는 작업을 지키는 용도. 비워두면("") 프로세스 검사를 하지 않는다.
#   - 패턴은 확장 정규식이며 공백을 포함해도 된다. 빈 줄과 # 주석 줄은 무시.
#   - 다른 프로그램까지 잡히지 않도록 경로를 포함해 좁게 쓸 것(main.py 만 쓰면 안 됨).
#   - 명령줄 전체를 보므로 `vim .../main.py` 처럼 파일을 열어두기만 해도 매칭된다.
#   - 프로세스가 멈춰서 끝나지 않는 경우는 아래 WATCH_PROCESS_MAX_HOURS 가 막는다.
# 예:
# WATCH_PROCESSES="
# ATG_PIP-seq_QC/src/main.py
# other_pipeline/run.sh
# "

WATCH_PROCESSES="
ATG_PIP-seq_QC/src/main.py
"

# 감시 프로세스의 최대 보호 시간(시). 매칭된 프로세스가 이보다 오래 실행됐으면
# (ps etimes 기준, 대기 시간 포함) 멈춘 작업으로 보고 예외에서 뺀다. 그 뒤로는
# CPU/디스크/네트워크로만 판단하므로, 대기 구간에 들어가면 IDLE_MINUTES 후 꺼진다.
# 로그에는 매 검사마다 "WARN process:... 초과 → 예외 해제" 가 남는다.
# 이보다 오래 걸리는 파이프라인이면 값을 늘릴 것. 0 이면 상한 없음.
WATCH_PROCESS_MAX_HOURS=3

# 디스크 I/O 활동 감지 여부와 임계값(KB/s). NGS 등 I/O 바운드 잡 보호용.
CHECK_DISK_IO=true
DISK_IO_THRESHOLD_KBPS=200

# 네트워크 I/O 활동 감지 여부와 임계값(KB/s). 대용량 다운로드 보호용.
# CPU는 전체 코어 평균이라(8 vCPU에서 1코어 20% = 전체 2.5%) 다운로드처럼 CPU를
# 거의 안 쓰는 I/O 바운드 작업은 CPU_THRESHOLD 로 못 잡는다. detached tmux 안에서
# 도는 다운로드/전송을 지키는 건 이 값이므로 너무 높게 잡지 말 것.
CHECK_NET_IO=true
NET_IO_THRESHOLD_KBPS=200

# 실제 로그인 세션(pty 가 붙은 `who` 항목)이 있는 것만으로도 종료를 막을지.
# false(기본값) 면 세션은 로그에만 남기고, CPU/디스크/네트워크가 낮으면 접속 중이어도
#   종료한다. → 창만 열어두고 자리를 비우는 일이 잦으면 이쪽이다(아래 실측 참고).
# true 면 사람이 접속해 있으면 CPU 가 0% 여도 안 꺼진다.
#
# 중요: 여기서 '실제 로그인 세션'은 detached tmux/screen 을 제외한 값이다.
#   tmux/screen 은 자기 pty 를 utmp 에 등록해두고 SSH 가 끊긴 뒤에도 그 항목을
#   남긴다. 그래서 아무도 접속해 있지 않아도 `who` 는 계속 1 user 를 보고하고,
#   tmux 서버가 죽거나 재부팅할 때까지 그 상태가 유지된다.
#   → `tmux new -s archive` 후 detach 하고 나간 인스턴스가 19시간 동안
#      "BUSY reason=login_session(1users)" 만 찍으며 안 꺼진 사례가 있었다.
#   이 항목들은 이제 자동으로 제외되고, 로그에는 mux=N 으로 따로 표시된다.
#   sshd 설정(--with-ssh-keepalive)으로는 못 막는 문제였다 — 정리할 SSH 연결이
#   애초에 없었기 때문.
#
# true 가 영영 안 꺼지는 원인이 될 수 있어서 기본값을 false 로 둔다. 터미널 창을
#   열어둔 채 퇴근하면 `who` 에 계속 남는다. 실측: 로그 8281줄 중 3216줄이
#   reason=login_session 이었고, 11-03 23시 ~ 11-04 08시까지 sessions=4 로
#   10시간 연속 안 꺼진 구간이 있었다.
#   → 그래서 세션 대신 하트비트로 보호한다. 터미널 작업은 이걸 ~/.bashrc 에 걸 것:
#        # ~/.bashrc  (기존 PROMPT_COMMAND 가 있으면 뒤에 이어 붙인다)
#        PROMPT_COMMAND="mkdir -p \"\$HOME/.cache/auto-shutdown\" && touch \"\$HOME/.cache/auto-shutdown/heartbeat\"${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
#     프롬프트가 뜰 때마다(=명령을 칠 때마다) touch 되므로, 창만 열어둔 상태와
#     실제로 쓰는 상태가 구분된다.
#
# CPU 를 거의 안 쓰는 작업(로그 읽기/코드 리뷰 등)을 오래 할 예정이면
# KEEPALIVE_FILE 로 수동 보호할 것.
SESSION_BLOCKS_SHUTDOWN=false

# pty 없는 SSH 연결(포트 22 established)만으로 종료를 막을지.
#
# false(기본값) 를 권장한다. Claude Code / VS Code Remote-SSH 같은 에이전트는
#   `sshd: user@notty` 로 접속해 pty 를 받지 않는다. 그래서 `who` 에는 안 보이고
#   (sessions=0) 포트 22 established 로만 잡히는데, 작업이 없어도 연결을 계속
#   유지한다. 이걸 true 로 두면 매분 "BUSY reason=ssh_conn(4)" 만 찍히며 영영
#   안 꺼진다 — 실제로 2주간 로그 8281줄 중 3556줄이 이 사유였다.
#
# 사람이/에이전트가 실제로 일하고 있는지는 하트비트 파일(HEARTBEAT_FILES)이 담당한다.
#   터미널 접속도 마찬가지다 — SESSION_BLOCKS_SHUTDOWN 기본값이 false 이므로
#   `who` 에 잡히는 것만으로는 보호되지 않는다. ~/.bashrc 에 PROMPT_COMMAND 를 걸 것.
SSH_BLOCKS_SHUTDOWN=false

# 이 파일이 존재하면 항상 '사용 중'으로 간주(수동 종료 방지 스위치).
#   종료 막기:  sudo touch /var/lib/auto-shutdown/keepalive
#   다시 켜기:  sudo rm  /var/lib/auto-shutdown/keepalive
KEEPALIVE_FILE=/var/lib/auto-shutdown/keepalive

# ---- 하트비트 (활동 기반 보호) ----------------------------------------------
# KEEPALIVE_FILE 은 '있으면 영구 보호'인 수동 스위치다. 하트비트는 반대로
# '최근에 touch 됐으면 보호'다 — 끄는 걸 잊어도 TTL 이 지나면 자동으로 풀린다.
#
# CPU 사용률은 "사람이/에이전트가 일하고 있나"의 대리지표로 부실하다. 추론은
# 원격에서 돌고 이 박스는 파일 읽기/grep 만 하므로 2 vCPU 평균 0~2% 가 정상이다.
# 그래서 활동 자체를 신호로 쓴다.
#
# 공백으로 구분된 목록이며 글롭(*)을 쓸 수 있다. 가장 최근 mtime 하나만 본다.
# root 아닌 사용자가 touch 할 수 있는 경로여야 한다(passwordless sudo 없이도 되게).
HEARTBEAT_FILES="/home/*/.cache/auto-shutdown/heartbeat"

# 하트비트 유효 시간(분). mtime 이 이 시간 안이면 사용 중으로 본다.
# 0 이면 하트비트 검사를 끈다.
#
# 주의: 이 값은 IDLE_MINUTES 에 더해진다. TTL 안에 있는 동안은 매 검사가 '사용 중'
#   으로 판정해 마지막 활동 시각을 갱신하므로, 마지막 touch 로부터 실제 종료까지는
#   HEARTBEAT_MAX_AGE_MINUTES + IDLE_MINUTES 가 걸린다.
#
#   기본값 30 + IDLE_MINUTES 30 = 마지막 활동으로부터 약 60분.
#   Claude 의 프롬프트 캐시가 1시간 유지되므로, 그 안에 돌아오면 캐시가 살아 있는
#   상태로 이어서 작업할 수 있도록 맞춘 값이다. IDLE_MINUTES 를 바꾸면 이 합도
#   같이 바뀌니, 1시간을 유지하려면 두 값의 합을 60 으로 두면 된다.
#
# touch 하는 쪽(예: Claude Code 훅):
#   mkdir -p ~/.cache/auto-shutdown && touch ~/.cache/auto-shutdown/heartbeat
HEARTBEAT_MAX_AGE_MINUTES=30

# true 면 실제 shutdown 대신 로그에 "would shutdown" 만 남긴다(검증용).
DRY_RUN=false

# 로그 파일 경로와 최대 크기(바이트). 초과하면 뒷부분만 남기고 잘라낸다.
LOG_FILE=/var/log/auto-shutdown.log
MAX_LOG_BYTES=5242880
